# No environment variables are needed. Public URLs (site, GitHub, LinkedIn, email,
# Calendly, project demos and repos, the BioVerify Telegram bot) are hardcoded in
# app/_lib/site-metadata.ts and app/_constants on purpose: a missing variable can't
# break a page or hide a link. (Held articles read Vercel's own VERCEL_ENV and stay
# hidden when it is missing: see app/_lib/held-articles.ts.)
