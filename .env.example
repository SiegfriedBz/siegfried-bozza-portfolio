# All variables are optional. Public URLs (GitHub, LinkedIn, email, Calendly,
# project demos and repos) are hardcoded in app/_constants on purpose.

# Canonical site URL (Open Graph, sitemap, robots). Defaults to https://www.siegfriedbozza.com
NEXT_PUBLIC_SITE_URL=

# BioVerify article: public Telegram bot link (the CTA is hidden when unset)
NEXT_PUBLIC_BIOVERIFY_TELEGRAM_URL=
